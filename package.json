{
  "name": "rookie-bakery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "order:status": "node --env-file-if-exists=.env server/order-status.js",
    "admin:create": "node --env-file-if-exists=.env server/admin-create.js",
    "db:export": "node --env-file-if-exists=.env server/db-tool.js export",
    "db:import": "node --env-file-if-exists=.env server/db-tool.js import"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dongle": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "express": "^5.3.0",
    "nodemailer": "^10.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
